# Gateway Nginx del backend MatchPoint (mismo valor que API_BASE_URL en local.properties).
API_BASE_URL=http://18.234.231.25:9090

# Cognito. El App Client debe ser publico/nativo, SIN client secret y con ALLOW_USER_AUTH.
COGNITO_REGION=us-east-1
COGNITO_APP_CLIENT_ID=

# Opcional, solo informativo para diagnostico en /api/health.
COGNITO_USER_POOL_ID=
